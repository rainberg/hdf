# ============ 数据库（PostgreSQL）============
# 本地开发推荐使用 Neon / Vercel Postgres 免费实例，直接用远程连接串即可（无需本地装 PG）
# Neon: https://neon.tech （注册后创建分支，复制 connection string）
# Vercel Postgres: 在 Vercel 项目 Storage 标签创建
# 本地自建 PG: postgresql://user:pass@localhost:5432/huadian?schema=public
DATABASE_URL="postgresql://user:pass@host:5432/huadian?schema=public"

# 集成测试专用库（可选，留空则跳过集成测试）
# TEST_DATABASE_URL="postgresql://user:pass@host:5432/huadian_test?schema=public"

# ============ NextAuth ============
# 用 `openssl rand -base64 32` 生成
AUTH_SECRET="change-me-to-a-random-string"
# 反向代理后启用
AUTH_TRUST_HOST="true"

# ============ 站点 ============
# 完整 URL（含协议），用于 sitemap / OG / 邮件链接
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ============ 第三方登录（可选）============
# Google OAuth: https://console.developers.google.com/
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# 微信开放平台: https://open.weixin.qq.com/
# WECHAT_CLIENT_ID=""
# WECHAT_CLIENT_SECRET=""

# ============ 邮件（可选，未来启用邮箱验证）============
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="华点 <noreply@huadian.example>"
